# name: test/sql/scalars.test
# group: [vgi_embed]
#
# End-to-end coverage of the embedding + similarity scalars through a real
# ATTACH + worker subprocess. Run with haybarn-unittest, so we LOAD vgi
# explicitly (require vgi would SKIP under haybarn). Embeddings are deterministic
# per model, but exact float values vary by ONNX build -- so we assert the vector
# LENGTH exactly, self-similarity ~ 1.0, and a planted related > unrelated
# comparison; never exact floats.

require-env VGI_EMBED_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'embed' AS embed (TYPE vgi, LOCATION '{VGI_EMBED_WORKER}');

# ---- embed(text): fixed-length FLOAT[] vector -------------------------------

query I
SELECT len(embed.embed('hello world')) = 384;
----
true

# Default model and explicit model agree on length.
query I
SELECT len(embed.embed('hello world', 'BAAI/bge-small-en-v1.5')) = 384;
----
true

# NULL / empty input yields a NULL vector.
query I
SELECT embed.embed(NULL) IS NULL;
----
true

query I
SELECT embed.embed('') IS NULL;
----
true

# ---- similarity: self-similarity is exactly ~1.0 ----------------------------

query I
SELECT ROUND(embed.similarity(embed.embed('cat'), embed.embed('cat')), 3) = 1.0;
----
true

# A related pair scores higher than an unrelated pair (planted: dog/puppy vs dog/airplane).
query I
SELECT embed.similarity(embed.embed('dog'), embed.embed('puppy'))
     > embed.similarity(embed.embed('dog'), embed.embed('airplane'));
----
true

# similarity on NULL / mismatched inputs is NULL (never crashes).
query I
SELECT embed.similarity(NULL, embed.embed('cat')) IS NULL;
----
true

# ---- embed over a VALUES table ---------------------------------------------

statement ok
CREATE TEMP TABLE docs AS
  SELECT * FROM (VALUES
    (1, 'the cat sat on the mat'),
    (2, 'a dog played in the park'),
    (3, NULL)
  ) AS t(id, body);

# Every non-null row embeds to a 384-length vector; the NULL row stays NULL.
query II
SELECT id, COALESCE(len(embed.embed(body)), -1) FROM docs ORDER BY id;
----
1	384
2	384
3	-1

# ---- query / passage retrieval asymmetry ------------------------------------

query I
SELECT len(embed.embed_query('how do I reset my password')) = 384;
----
true

query I
SELECT len(embed.embed_passage('Click forgot password to reset it.')) = 384;
----
true

# The query gets the bge instruction prefix; the passage does not -- so the two
# vectors for the same text differ.
query I
SELECT embed.similarity(embed.embed_query('reset password'),
                        embed.embed_passage('reset password')) < 1.0;
----
true

# ---- explicit retrieval models ---------------------------------------------

# Explicit retrieval models use the selected width and query prefix.
query II
SELECT len(embed.embed_query('reset password', 'BAAI/bge-base-en-v1.5')),
       len(embed.embed_passage('reset password', 'BAAI/bge-base-en-v1.5'));
----
768	768

query I
SELECT ROUND(embed.similarity(
    embed.embed_query('reset password', 'BAAI/bge-base-en-v1.5'),
    embed.embed('Represent this sentence for searching relevant passages: reset password',
                'BAAI/bge-base-en-v1.5')), 6) = 1.0;
----
true

query I
SELECT ROUND(embed.similarity(
    embed.embed_passage('reset password', 'BAAI/bge-base-en-v1.5'),
    embed.embed('reset password', 'BAAI/bge-base-en-v1.5')), 6) = 1.0;
----
true

query II
SELECT len(embed.embed_query('reset password', '')),
       len(embed.embed_passage('reset password', '  '));
----
384	384

query II
SELECT embed.embed_query(NULL, 'BAAI/bge-base-en-v1.5') IS NULL,
       embed.embed_passage('  ', 'BAAI/bge-base-en-v1.5') IS NULL;
----
true	true

statement error
SELECT embed.embed_query('hello', 'no/such-model');
----
Unknown embedding model

statement error
SELECT embed.embed_passage('hello', 'no/such-model');
----
Unknown embedding model

# ---- embedding_dim ---------------------------------------------------------

query I
SELECT embed.embedding_dim('BAAI/bge-small-en-v1.5');
----
384

query I
SELECT embed.embedding_dim('BAAI/bge-base-en-v1.5');
----
768

# ---- composed examples (embed_query/embed_passage/embed + similarity) -------
# Mirrors the composed example queries in vgi_embed/scalars.py. Only the stable
# shape is asserted (ranked ids, winning labels, matched pairs) -- never floats.

# Semantic search: the two password-help passages rank top-2, in this order.
query I
WITH docs(id, body) AS (VALUES
    (1, 'Reset your password from the account settings page.'),
    (2, 'Our office is closed on public holidays.'),
    (3, 'Invoices are emailed on the first day of each month.'),
    (4, 'Forgot your login? Use the password recovery link to sign in again.')),
q AS (SELECT embed.embed_query('how do I reset my password') AS v)
SELECT d.id FROM docs AS d CROSS JOIN q
ORDER BY embed.similarity(q.v, embed.embed_passage(d.body)) DESC, d.id LIMIT 2;
----
1
4

# Zero-shot classification: the closest label wins for every ticket.
query II
WITH tickets(ticket) AS (VALUES
    ('The app crashes every time I open the settings screen.'),
    ('I was charged twice for my subscription this month.'),
    ('Could you add a dark mode option?')),
labels(label) AS (VALUES ('bug report'), ('billing problem'), ('feature request'))
SELECT t.ticket, arg_max(l.label, embed.similarity(embed.embed(t.ticket), embed.embed(l.label)))
FROM tickets AS t CROSS JOIN labels AS l
GROUP BY t.ticket ORDER BY t.ticket;
----
Could you add a dark mode option?	feature request
I was charged twice for my subscription this month.	billing problem
The app crashes every time I open the settings screen.	bug report

# Near-duplicate detection: exactly the two paraphrase pairs clear 0.8.
query II
WITH titles(id, title) AS (VALUES
    (1, 'How to reset a forgotten password'),
    (2, 'Steps for resetting your lost password'),
    (3, 'Quarterly revenue grew by twelve percent'),
    (4, 'Revenue increased 12% this quarter'),
    (5, 'Best hiking trails near Denver')),
v AS (SELECT id, embed.embed(title) AS vec FROM titles)
SELECT a.id, b.id FROM v AS a JOIN v AS b ON a.id < b.id
WHERE embed.similarity(a.vec, b.vec) > 0.8 ORDER BY a.id;
----
1	2
3	4

statement ok
DETACH embed;
